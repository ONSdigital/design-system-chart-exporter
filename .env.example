# Local development environment for running the service outside Docker.
# Copy to .env (git-ignored) and adjust as needed: `cp .env.example .env`.
# `make run` loads this file automatically when present.

# --- Service settings (CHART_EXPORTER_ prefix) ---
CHART_EXPORTER_S3_BUCKET=ons-charts
# Point at the local Floci S3 emulator (started by `make up-deps`).
CHART_EXPORTER_S3_ENDPOINT_URL=http://localhost:4566
# Launch Chromium at startup so readiness is meaningful and a broken install fails fast.
CHART_EXPORTER_LAUNCH_BROWSER_ON_STARTUP=true

# --- AWS credentials (read by boto3 directly, not by Settings) ---
# Floci accepts any dummy values; NEVER put real AWS credentials here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
